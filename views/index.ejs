<%- include('partials/header') %>
<% var title = 'Home'; %>
<style>
.hero{background:#f0fdf4;padding:56px 0 48px}
.hero-inner{max-width:1280px;margin:0 auto;padding:0 1rem;text-align:center}
.hero-inner h1{font-size:2.5rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;line-height:1.2}
@media(min-width:768px){.hero-inner h1{font-size:3.5rem}}
.hero-inner h1 span{color:#15803d}
.hero-inner p{color:#6b7280;font-size:1.125rem;max-width:560px;margin:12px auto 0;line-height:1.6}
.hero-btns{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:24px;flex-wrap:wrap}
.hero-btns .btn{background:#1a1a1a;color:#fff;padding:12px 32px;border-radius:12px;font-weight:600;text-decoration:none;transition:background .15s;box-shadow:0 10px 15px -3px rgba(0,0,0,.1)}
.hero-btns .btn:hover{background:#333}
.hero-btns .link{color:#4b5563;font-weight:500;padding:12px 24px;text-decoration:none;transition:color .15s}
.hero-btns .link:hover{color:#1a1a1a}
.featured-strip{max-width:1280px;margin:32px auto 0;padding:0 1rem;overflow-x:auto}
.featured-strip-inner{display:flex;gap:16px;justify-content:center}
.featured-strip img{width:160px;height:200px;border-radius:12px;object-fit:cover;border:2px solid #dcfce7;transition:all .2s;flex-shrink:0}
.featured-strip img:hover{border-color:#15803d;transform:translateY(-4px);box-shadow:0 8px 20px rgba(22,163,74,.15)}
.stats{background:#fff}
.stats-inner{max-width:1280px;margin:0 auto;padding:0 1rem;display:grid;grid-template-columns:repeat(4,1fr);gap:0}
.stats-inner>div{padding:24px;text-align:center;border-bottom:1px solid #dcfce7}
.stats-inner .num{font-size:1.5rem;font-weight:800;color:#15803d;margin-bottom:2px}
.stats-inner .lbl{font-size:13px;color:#6b7280;font-weight:500}
.collection{max-width:1280px;margin:0 auto;padding:48px 1rem}
.collection-header{margin-bottom:28px}
.collection-header h2{font-size:1.5rem;font-weight:700;color:#1a1a1a}
.collection-header p{color:#6b7280;font-size:14px;margin-top:4px}
.grid-4{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
@media(min-width:768px){.grid-4{grid-template-columns:repeat(3,1fr)}}@media(min-width:1024px){.grid-4{grid-template-columns:repeat(4,1fr)}}
.card{background:#fff;overflow:hidden;transition:all .2s}
.card:hover{box-shadow:0 10px 25px -5px rgba(0,0,0,.06),0 8px 10px -6px rgba(0,0,0,.02);border-radius:12px}
.card-img{aspect-ratio:4/5;overflow:hidden;background:#f0fdf4;border-radius:12px}
.card-img img{width:100%;height:100%;object-fit:cover;transition:transform .3s;border-radius:12px}
.card:hover .card-img img{transform:scale(1.05)}
.card-body{padding:14px 0 0}
.card-body .cat{display:inline-block;font-size:10px;font-weight:600;color:#15803d;background:#f0fdf4;border:1px solid #dcfce7;padding:2px 8px;border-radius:999px;margin-bottom:6px}
.card-body h3{font-weight:600;color:#1a1a1a;font-size:14px;margin-bottom:4px}
.card-body .desc{font-size:12px;color:#9ca3af;margin-bottom:12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.5}
.card-footer{display:flex;align-items:center;justify-content:space-between}
.card-footer .price{font-weight:700;color:#1a1a1a}
.card-footer .add{background:#1a1a1a;color:#fff;font-size:12px;padding:8px 14px;border-radius:8px;text-decoration:none;font-weight:500;transition:background .15s}
.card-footer .add:hover{background:#333}
</style>

<div class="hero">
  <div class="hero-inner">
    <h1>Welcome to <span>Duka Store</span></h1>
    <p>Eight premium essentials. One flat price. Pick what you need &middot; it's all 500 TZS.</p>
    <div class="hero-btns">
      <a href="#collection" class="btn">Shop Collection</a>
      <a href="/cart" class="link">View Cart &rarr;</a>
    </div>
  </div>
  <div class="featured-strip">
    <div class="featured-strip-inner">
      <% var strips = ['img1.jpg','img7.jpeg','img6.jpg','img4.png']; %>
      <% strips.forEach(function(s) { %>
      <img src="/images/<%= s %>" alt="<%= s %>">
      <% }); %>
    </div>
  </div>
</div>

<div class="stats">
  <div class="stats-inner">
    <div><div class="num">500</div><div class="lbl">TZS per item</div></div>
    <div><div class="num">8</div><div class="lbl">curated styles</div></div>
    <div><div class="num">Instant</div><div class="lbl">checkout</div></div>
    <div><div class="num">Secure</div><div class="lbl">by Snippe</div></div>
  </div>
</div>

<div id="collection" class="collection">
  <div class="collection-header">
    <h2>All Products</h2>
    <p>Everything you need, nothing you don't.</p>
  </div>
  <div class="grid-4">
    <% products.forEach(function(p) { %>
    <div class="card">
      <a href="/cart/add/<%= p.id %>"><div class="card-img"><img src="<%= p.image %>" alt="<%= p.name %>"></div></a>
      <div class="card-body">
        <span class="cat"><%= p.category %></span>
        <h3><%= p.name %></h3>
        <p class="desc"><%= p.description %></p>
        <div class="card-footer">
          <span class="price">TZS 500</span>
          <a href="/cart/add/<%= p.id %>" class="add">+ Add</a>
        </div>
      </div>
    </div>
    <% }); %>
  </div>
</div>

<%- include('partials/footer') %>
