<%- include('partials/header') %>
<% title = 'Order ' + order.reference; %>
<style>
.od{max-width:768px;margin:0 auto;padding:32px 1rem}
.back{margin-bottom:24px}.back a{color:#6b7280;text-decoration:none;font-size:14px;display:flex;align-items:center;gap:4px}.back a:hover{color:#1a1a1a}
.card{background:#fff;border:1px solid #dcfce7;border-radius:16px;padding:24px 32px}
.card .top{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}
.card .top h1{font-size:1.25rem;font-weight:700;color:#1a1a1a}
.card .top .ref{font-family:monospace;font-size:14px;color:#94a3b8;background:#f0fdf4;padding:4px 12px;border-radius:8px}
.grid-4{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-bottom:24px}
@media(min-width:640px){.grid-4{grid-template-columns:repeat(4,1fr)}}
.grid-4 .lbl{font-size:12px;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;font-weight:500;margin-bottom:6px}
.grid-4 .val{font-size:14px;font-weight:500;color:#1a1a1a}
.grid-4 .val-lg{font-size:1.25rem;font-weight:700;color:#1a1a1a}
.stat{display:inline-block;padding:4px 12px;border-radius:999px;font-size:14px;font-weight:600}
.stat-completed{background:#dcfce7;color:#15803d}
.stat-failed{background:#fef2f2;color:#991b1b}
.stat-cancelled{background:#f3f4f6;color:#4b5563}
.stat-pending{background:#fef9c3;color:#854d0e}
.stat-expired{background:#fef9c3;color:#854d0e}
.divider{border-top:1px solid #dcfce7;margin:20px 0}
.sec-title{font-size:12px;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;font-weight:500;margin-bottom:12px}
.items{display:flex;flex-direction:column;gap:12px}
.item-row{display:flex;align-items:center;justify-content:space-between;background:#f0fdf4;border-radius:12px;padding:12px 16px;font-size:14px}
.item-row .left{display:flex;align-items:center;gap:12px}
.item-row .left img{width:40px;height:40px;border-radius:8px;object-fit:cover;border:1px solid #dcfce7;background:#fff}
.item-row .left .name{font-weight:500;color:#1a1a1a}
.item-row .left .qty{color:#94a3b8}
.item-row .price{font-weight:500;color:#1a1a1a}
.total-row{display:flex;align-items:center;justify-content:space-between;margin-top:16px;padding-top:16px;border-top:1px solid #dcfce7}
.total-row .lbl{font-weight:600;color:#1a1a1a}
.total-row .big{font-size:1.25rem;font-weight:700;color:#1a1a1a}
.info-msg{background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;border-radius:12px;padding:12px 20px;margin-bottom:24px;font-size:14px;display:flex;align-items:center;gap:8px}
.continue{text-align:center;margin-top:24px}
.continue a{color:#15803d;text-decoration:none;font-size:14px;font-weight:500}
.continue a:hover{color:#166534}
</style>
<div class="od">
  <% if (typeof error !== 'undefined' && error) { %>
  <div class="info-msg" style="background:#fef2f2;border-color:#fecaca;color:#991b1b">Payment failed: <%= error %></div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query && req.query.from === 'dash') { %>
  <div class="back"><a href="/dashboard"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg> Back to Dashboard</a></div>
  <% } %>
  <% if (order.status === 'pending' && order.payment_method === 'mobile') { %>
  <div class="info-msg"><svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> A USSD push has been sent to your phone. Check your phone and enter your PIN to complete payment.</div>
  <% } %>
  <div class="card">
    <div class="top"><h1>Order Details</h1><span class="ref"><%= order.reference %></span></div>
    <div class="grid-4">
      <div><div class="lbl">Status</div><span class="stat stat-<%= order.status %>"><%= order.status %></span></div>
      <div><div class="lbl">Method</div><div class="val"><%= order.payment_method %></div></div>
      <div><div class="lbl">Amount</div><div class="val-lg">TZS <%= order.amount.toLocaleString() %></div></div>
      <div><div class="lbl">Date</div><div class="val"><%= new Date(order.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></div></div>
      <% if (order.snippe_reference) { %><div><div class="lbl">Snippe Ref</div><div class="val" style="font-family:monospace;font-size:12px;word-break:break-all"><%= order.snippe_reference %></div></div><% } %>
    </div>
    <div class="divider"></div>
    <div class="sec-title">Customer</div>
    <p style="color:#1a1a1a;font-weight:500"><%= order.customer_name %></p>
    <p style="color:#6b7280;font-size:14px"><%= order.customer_email %></p>
    <p style="color:#6b7280;font-size:14px"><%= order.customer_phone %></p>
    <div class="divider"></div>
    <div class="sec-title">Items</div>
    <div class="items">
      <% order.items.forEach(function(item) { %>
      <div class="item-row">
        <div class="left">
          <img src="<%= item.image || '/images/tee.svg' %>" alt="<%= item.product_name %>">
          <div><span class="name"><%= item.product_name %></span><span class="qty"> x<%= item.quantity %></span></div>
        </div>
        <span class="price">TZS <%= item.subtotal.toLocaleString() %></span>
      </div>
      <% }); %>
    </div>
    <div class="total-row"><span class="lbl">Total</span><span class="big">TZS <%= order.amount.toLocaleString() %></span></div>
  </div>
  <div class="continue"><a href="/">Continue Shopping &rarr;</a></div>
</div>
<%- include('partials/footer') %>
