<%- include('partials/header') %>
<% title = 'Cart'; %>
<style>
.cart{max-width:1280px;margin:0 auto;padding:32px 1rem}
.cart-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:32px}
.cart-header h1{font-size:1.5rem;font-weight:700;color:#1a1a1a}
.cart-header p{color:#6b7280;font-size:14px;margin-top:4px}
.cart-header a{color:#15803d;font-size:14px;font-weight:500;text-decoration:none}
.cart-header a:hover{color:#166534}
.cart-grid{display:grid;gap:32px}@media(min-width:1024px){.cart-grid{grid-template-columns:2fr 1fr}}
.cart-items{display:flex;flex-direction:column;gap:12px}
.cart-item{background:#fff;border:1px solid #dcfce7;border-radius:12px;padding:16px 20px;display:flex;align-items:flex-start;gap:16px;transition:box-shadow .15s}
.cart-item:hover{box-shadow:0 4px 6px -1px rgba(22,163,74,.06)}
.cart-item img{width:96px;height:96px;border-radius:12px;object-fit:cover;flex-shrink:0;border:1px solid #dcfce7;background:#f0fdf4}
.cart-item .info{flex:1;min-width:0}
.cart-item .info .top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.cart-item .info .top h3{font-weight:600;color:#1a1a1a;font-size:14px}
.cart-item .info .top .subtotal{font-weight:700;color:#1a1a1a;white-space:nowrap}
.cart-item .info .cat{color:#94a3b8;font-size:12px;margin-top:2px}
.cart-item .bottom{display:flex;align-items:center;justify-content:space-between;margin-top:16px}
.qty-badge{display:flex;align-items:center;border:1px solid #e5e7eb;border-radius:8px;overflow:hidden}
.qty-badge span{padding:6px 12px;font-size:14px;color:#4b5563;background:#f9fafb;border-right:1px solid #e5e7eb}
.qty-badge .per{font-size:12px;color:#94a3b8;padding:6px 8px}
.remove{color:#94a3b8;font-size:12px;text-decoration:none;display:flex;align-items:center;gap:4px;transition:color .15s}
.remove:hover{color:#dc2626}
.summary{background:#fff;border:1px solid #dcfce7;border-radius:12px;padding:24px;position:sticky;top:88px}
.summary h3{font-weight:600;color:#1a1a1a;margin-bottom:16px}
.summary .row{display:flex;justify-content:space-between;font-size:14px;margin-bottom:12px;color:#6b7280}
.summary .row .free{color:#15803d;font-weight:600}
.summary .total{border-top:1px solid #dcfce7;padding-top:12px;margin-top:12px;display:flex;justify-content:space-between;font-weight:700;font-size:15px}
.summary .total .big{font-size:1.25rem;color:#1a1a1a}
.btn-checkout{display:block;width:100%;background:#1a1a1a;color:#fff;text-align:center;padding:14px;border-radius:12px;font-weight:600;text-decoration:none;margin-top:20px;transition:background .15s;font-size:14px;box-shadow:0 10px 15px -3px rgba(0,0,0,.1)}
.btn-checkout:hover{background:#333}
.empty{background:#f0fdf4;border-radius:16px;padding:64px;text-align:center;border:2px dashed #bbf7d0}
.empty p{color:#6b7280;margin-bottom:16px}
.empty .btn{display:inline-block;background:#1a1a1a;color:#fff;padding:12px 28px;border-radius:12px;font-weight:500;text-decoration:none;transition:background .15s;box-shadow:0 10px 15px -3px rgba(0,0,0,.1)}
.empty .btn:hover{background:#333}
</style>
<div class="cart">
  <div class="cart-header">
    <div><h1>Cart</h1><p><%= items.length %> item<%= items.length !== 1 ? 's' : '' %></p></div>
    <a href="/">&larr; Continue shopping</a>
  </div>
  <% if (!items.length) { %>
  <div class="empty"><p>Your cart is empty.</p><a href="/" class="btn">Browse Products</a></div>
  <% } else { %>
  <div class="cart-grid">
    <div class="cart-items">
      <% items.forEach(function(item, idx) { %>
      <div class="cart-item">
        <img src="<%= item.product.image %>" alt="<%= item.product.name %>">
        <div class="info">
          <div class="top">
            <div><h3><%= item.product.name %></h3><p class="cat"><%= item.product.category %></p></div>
            <span class="subtotal">TZS <%= item.subtotal.toLocaleString() %></span>
          </div>
          <div class="bottom">
            <div class="qty-badge"><span><%= item.quantity %></span><span class="per">x TZS <%= item.product.price.toLocaleString() %></span></div>
            <a href="/cart/remove/<%= idx %>" class="remove"><svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg> Remove</a>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
    <div class="summary">
      <h3>Summary</h3>
      <div class="row"><span>Items (<%= items.length %>)</span><span>TZS <%= total.toLocaleString() %></span></div>
      <div class="row"><span>Shipping</span><span class="free">Free</span></div>
      <div class="total"><span>Total</span><span class="big">TZS <%= total.toLocaleString() %></span></div>
      <a href="/checkout" class="btn-checkout">Checkout</a>
    </div>
  </div>
  <% } %>
</div>
<%- include('partials/footer') %>
