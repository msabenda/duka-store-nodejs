<%- include('partials/header') %>
<% title = 'Checkout'; %>
<style>
.checkout{max-width:1280px;margin:0 auto;padding:32px 1rem}
.steps{display:flex;align-items:center;justify-content:center;gap:24px;margin-bottom:48px;font-size:14px}
.step{display:flex;align-items:center;gap:8px}
.step-num{width:28px;height:28px;border-radius:999px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700}
.sd{background:#e5e7eb;color:#6b7280}
.sa{background:#1a1a1a;color:#fff}
.sp{background:#e5e7eb;color:#9ca3af}
.sl{color:#6b7280}.sl.sa{color:#1a1a1a;font-weight:600}.sl.sp{color:#9ca3af}
.checkout-grid{display:grid;gap:32px}@media(min-width:1024px){.checkout-grid{grid-template-columns:3fr 2fr}}
.section{background:#fff;border:1px solid #dcfce7;border-radius:12px;padding:24px 32px;margin-bottom:24px}
.section h2{font-weight:600;color:#1a1a1a;margin-bottom:24px;display:flex;align-items:center;gap:8px;font-size:16px}
.section h2 svg{width:20px;height:20px;color:#94a3b8}
.form-grid{display:grid;gap:16px}
.form-grid .full{grid-column:1/-1}
.form-grid label{display:block;font-size:14px;font-weight:500;color:#1a1a1a;margin-bottom:6px}
.form-grid input{width:100%;padding:12px 16px;border:1px solid #e5e7eb;border-radius:12px;font-size:14px;color:#1a1a1a;outline:none;transition:all .15s}
.form-grid input:focus{border-color:#15803d;box-shadow:0 0 0 2px rgba(22,163,74,.15)}
.pay-grid{display:grid;grid-template-columns:1fr;gap:12px}@media(min-width:640px){.pay-grid{grid-template-columns:repeat(3,1fr)}}
.pay-card{border:2px solid #dcfce7;border-radius:12px;padding:20px;cursor:pointer;transition:all .15s;font-family:inherit;background:#f0fdf4;text-align:left}
.pay-card:hover{border-color:#15803d;background:#dcfce7}
.pay-card .icon{width:40px;height:40px;background:#fff;border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:12px;border:1px solid #dcfce7}
.pay-card:hover .icon{border-color:#15803d}
.pay-card .icon svg{width:20px;height:20px;color:#15803d}
.pay-card h4{font-weight:600;font-size:14px;color:#1a1a1a;margin-bottom:4px}
.pay-card p{font-size:12px;color:#6b7280;line-height:1.5}
.summary-card{background:#fff;border:1px solid #dcfce7;border-radius:12px;padding:24px 32px;position:sticky;top:88px}
.summary-card h2{font-weight:600;color:#1a1a1a;margin-bottom:20px}
.summary-item{display:flex;align-items:flex-start;gap:12px;margin-bottom:16px}
.summary-item img{width:48px;height:48px;border-radius:8px;object-fit:cover;flex-shrink:0;border:1px solid #dcfce7;background:#f0fdf4}
.summary-item .info{flex:1;min-width:0}
.summary-item .info .name{font-size:14px;font-weight:500;color:#1a1a1a}
.summary-item .info .qty{font-size:12px;color:#94a3b8}
.summary-item .price{font-size:14px;font-weight:500;color:#1a1a1a;white-space:nowrap}
.summary-totals{border-top:1px solid #dcfce7;padding-top:20px;margin-top:20px}
.summary-totals .row{display:flex;justify-content:space-between;font-size:14px;margin-bottom:10px;color:#6b7280}
.summary-totals .row .free{color:#15803d;font-weight:600;font-size:12px}
.summary-totals .grand{border-top:1px solid #dcfce7;padding-top:10px;margin-top:10px;display:flex;justify-content:space-between;font-weight:700;font-size:15px}
.summary-totals .grand .big{font-size:1.25rem;color:#1a1a1a}
.security{border:1px solid #bbf7d0;background:#f0fdf4;border-radius:12px;padding:16px;margin-top:24px;display:flex;align-items:flex-start;gap:12px;font-size:12px;color:#4b5563}
.security svg{width:16px;height:16px;color:#15803d;flex-shrink:0;margin-top:2px}
.security .bold{font-weight:500;color:#1a1a1a;margin-bottom:2px}
</style>
<div class="checkout">
  <div class="steps">
    <div class="step"><span class="step-num sd">1</span><span class="sl">Cart</span></div>
    <div class="step"><span class="step-num sa">2</span><span class="sl sa">Checkout</span></div>
    <div class="step"><span class="step-num sp">3</span><span class="sl sp">Confirmation</span></div>
  </div>
  <div class="checkout-grid">
    <div>
      <form id="checkout-form" method="POST">
        <div class="section">
          <h2><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>Customer Details</h2>
          <div class="form-grid">
            <div class="full"><label for="customer_name">Full Name</label><input type="text" name="customer_name" id="customer_name" value="<%= user.firstname %> <%= user.lastname %>" placeholder="Your full name" required></div>
            <div><label for="customer_email">Email</label><input type="email" name="customer_email" id="customer_email" value="<%= user.email %>" placeholder="your@email.com" required></div>
            <div><label for="customer_phone">Phone Number</label><input type="tel" name="customer_phone" id="customer_phone" placeholder="+255 7XX XXX XXX" required></div>
          </div>
        </div>
        <div class="section">
          <h2><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>Payment Method</h2>
          <div class="pay-grid">
            <button type="button" onclick="submitPay('mobile')" class="pay-card"><div class="icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg></div><h4>Mobile Money</h4><p>Pay via M-Pesa, Tigo Pesa or Airtel Money</p></button>
            <button type="button" onclick="submitPay('card')" class="pay-card"><div class="icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg></div><h4>Card</h4><p>Visa, Mastercard and more</p></button>
            <button type="button" onclick="submitPay('qr')" class="pay-card"><div class="icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/></svg></div><h4>QR Code</h4><p>Scan with your banking app</p></button>
          </div>
        </div>
      </form>
    </div>
    <div>
      <div class="summary-card">
        <h2>Order Summary</h2>
        <% items.forEach(function(item) { %>
        <div class="summary-item">
          <img src="<%= item.product.image %>" alt="<%= item.product.name %>">
          <div class="info"><div class="name"><%= item.product.name %></div><div class="qty">x <%= item.quantity %></div></div>
          <span class="price">TZS <%= item.subtotal.toLocaleString() %></span>
        </div>
        <% }); %>
        <div class="summary-totals">
          <div class="row"><span>Subtotal</span><span>TZS <%= total.toLocaleString() %></span></div>
          <div class="row"><span>Shipping</span><span class="free">Free</span></div>
          <div class="grand"><span>Total</span><span class="big">TZS <%= total.toLocaleString() %></span></div>
        </div>
        <div class="security">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          <div><div class="bold">Secure payment</div><p>Your information is protected by Snippe.</p></div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
function submitPay(method) {
  var form = document.getElementById('checkout-form');
  var routes = { mobile: '/checkout/mobile', card: '/checkout/card', qr: '/checkout/qr' };
  form.action = routes[method];
  form.submit();
}
</script>
<%- include('partials/footer') %>
