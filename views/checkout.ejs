<%# 💡 LEARNER'S NOTE — YOUR CUSTOM CHECKOUT (you build this page yourself) %>
<%# Customer details + direct mobile-money payment. Submits only to /checkout/mobile. %>
<%# Snippe's hosted Sessions checkout is retained in source comments as an educational alternative, not active. %>
<%# Series 7 active first-party mobile-money checkout. %>
<%- include('partials/header') %>
<% title = 'Checkout'; %>
<style>
.checkout{max-width:1180px;margin:0 auto;padding:28px 1rem 64px}
.checkout-heading{margin:0 auto 32px;max-width:680px;text-align:center}
.checkout-heading .eyebrow{color:#15803d;font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;margin-bottom:8px}
.checkout-heading h1{font-size:clamp(1.75rem,4vw,2.4rem);line-height:1.15;letter-spacing:-.035em;margin-bottom:10px}
.checkout-heading p{color:#6b7280;font-size:14px;line-height:1.6}
.steps{display:flex;align-items:center;justify-content:center;margin-bottom:28px;color:#6b7280;font-size:12px}
.step{display:flex;align-items:center;gap:7px;white-space:nowrap}
.step+.step:before{content:"";display:block;width:clamp(18px,7vw,72px);height:1px;background:#d1fae5;margin:0 clamp(6px,2vw,18px)}
.step-num{width:26px;height:26px;border-radius:999px;display:grid;place-items:center;font-size:12px;font-weight:700;background:#f0fdf4;color:#15803d;border:1px solid #bbf7d0}
.step[aria-current="step"]{color:#111827;font-weight:600}.step[aria-current="step"] .step-num{background:#1a1a1a;border-color:#1a1a1a;color:#fff}
.checkout-grid{display:grid;gap:28px;align-items:start}
.checkout-main{min-width:0}.section,.summary-card{background:#fff;border:1px solid #dcfce7;border-radius:16px;box-shadow:0 10px 30px rgba(21,128,61,.045)}
.section{padding:24px;margin-bottom:20px}
.section-head{display:flex;align-items:flex-start;gap:12px;margin-bottom:22px}
.section-icon{width:36px;height:36px;border-radius:10px;background:#f0fdf4;color:#15803d;display:grid;place-items:center;flex:0 0 auto}
.section-icon svg{width:19px;height:19px}.section-head h2{font-size:16px;line-height:1.3;margin-bottom:3px}.section-head p{color:#6b7280;font-size:12px;line-height:1.45}
.form-grid{display:grid;gap:17px}.field.full{grid-column:1/-1}
.field label{display:block;font-size:13px;font-weight:600;color:#1f2937;margin-bottom:7px}.required{color:#b91c1c}
.field input{width:100%;min-height:46px;padding:11px 13px;border:1px solid #d1d5db;border-radius:10px;background:#fff;color:#111827;font:inherit;font-size:14px;transition:border-color .15s,box-shadow .15s}
.field input:hover{border-color:#9ca3af}.field input:focus-visible{outline:3px solid rgba(21,128,61,.18);outline-offset:1px;border-color:#15803d}.field input:invalid:not(:placeholder-shown){border-color:#dc2626}
.field-help{display:flex;align-items:flex-start;gap:6px;color:#6b7280;font-size:12px;line-height:1.45;margin-top:7px}.field-help svg{width:14px;height:14px;flex:0 0 auto;margin-top:1px;color:#15803d}
.networks-label{font-size:12px;color:#6b7280;margin-bottom:9px}.network-list{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px}.network{padding:7px 10px;border:1px solid #d1fae5;border-radius:999px;background:#f0fdf4;color:#166534;font-size:11px;font-weight:600}
.amount-due{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;padding:16px;border:1px solid #dcfce7;border-radius:12px;background:#f8fff9;margin-bottom:14px}.amount-due span{display:block;color:#6b7280;font-size:12px;margin-bottom:4px}.amount-due strong{font-size:clamp(1.3rem,4vw,1.65rem);letter-spacing:-.025em;white-space:nowrap}.amount-due .currency{color:#15803d;font-size:11px;font-weight:700;letter-spacing:.05em;margin:0 0 4px}
.pay-button{width:100%;min-height:50px;border:0;border-radius:11px;padding:14px 18px;background:#1a1a1a;color:#fff;font:inherit;font-size:15px;font-weight:700;cursor:pointer;box-shadow:0 8px 18px rgba(0,0,0,.14);transition:background .15s,transform .15s,box-shadow .15s}.pay-button:hover{background:#333;box-shadow:0 10px 22px rgba(0,0,0,.18);transform:translateY(-1px)}.pay-button:focus-visible{outline:3px solid rgba(21,128,61,.35);outline-offset:3px}.pay-button:active{transform:translateY(0)}
.payment-note{display:flex;align-items:flex-start;gap:9px;color:#4b5563;font-size:12px;line-height:1.55;margin-top:14px}.payment-note svg{width:17px;height:17px;color:#15803d;flex:0 0 auto;margin-top:1px}
.summary-card{padding:24px}.summary-card h2{font-size:17px;margin-bottom:20px}.summary-items{display:grid;gap:16px}.summary-item{display:flex;align-items:center;gap:12px}.summary-item img{width:54px;height:62px;border-radius:10px;object-fit:cover;flex:0 0 auto;border:1px solid #dcfce7;background:#f0fdf4}.summary-item .info{flex:1;min-width:0}.summary-item .name{font-size:13px;font-weight:600;line-height:1.4}.summary-item .qty{font-size:11px;color:#6b7280;margin-top:3px}.summary-item .price{font-size:13px;font-weight:600;white-space:nowrap}
.summary-totals{border-top:1px solid #dcfce7;padding-top:18px;margin-top:20px}.summary-totals .row,.summary-totals .grand{display:flex;justify-content:space-between;gap:16px}.summary-totals .row{font-size:13px;color:#6b7280;margin-bottom:11px}.summary-totals .free{color:#15803d;font-weight:600}.summary-totals .grand{border-top:1px solid #dcfce7;padding-top:15px;margin-top:15px;font-weight:700;align-items:baseline}.summary-totals .big{font-size:1.2rem;white-space:nowrap}
.trust-note{display:flex;gap:10px;align-items:flex-start;border-top:1px solid #dcfce7;padding-top:18px;margin-top:20px;color:#4b5563;font-size:11px;line-height:1.5}.trust-note svg{width:17px;height:17px;color:#15803d;flex:0 0 auto}.trust-note strong{display:block;color:#1f2937;font-size:12px;margin-bottom:2px}
@media(min-width:700px){.checkout{padding:36px 1.5rem 72px}.form-grid{grid-template-columns:1fr 1fr}.section{padding:28px}.summary-card{padding:26px}}
@media(min-width:960px){.checkout-grid{grid-template-columns:minmax(0,1.35fr) minmax(320px,.8fr)}.summary-card{position:sticky;top:88px}}
@media(max-width:540px){.checkout{padding-top:20px}.checkout-heading{margin-bottom:23px}.steps{justify-content:space-between}.step+.step:before{width:12px;margin:0 5px}.step-num{width:24px;height:24px}.section,.summary-card{border-radius:14px}.section{padding:20px}.summary-card{padding:20px}.amount-due{align-items:flex-start;flex-direction:column;gap:4px}.amount-due .currency{display:none}}
@media(prefers-reduced-motion:reduce){.pay-button,.field input{transition:none}.pay-button:hover{transform:none}}
</style>
<div class="checkout">
  <nav class="steps" aria-label="Checkout progress">
    <div class="step"><span class="step-num" aria-hidden="true">1</span><span>Cart</span></div>
    <div class="step" aria-current="step"><span class="step-num" aria-hidden="true">2</span><span>Payment</span></div>
    <div class="step"><span class="step-num" aria-hidden="true">3</span><span>Confirmation</span></div>
  </nav>

  <header class="checkout-heading">
    <p class="eyebrow">Secure checkout</p>
    <h1>Complete your order</h1>
    <p>Confirm your details, then approve the mobile money prompt on your phone.</p>
  </header>

  <div class="checkout-grid">
    <div class="checkout-main">
      <form id="checkout-form" method="POST" action="/checkout/mobile">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <section class="section" aria-labelledby="customer-heading">
          <div class="section-head">
            <span class="section-icon"><svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.118a7.5 7.5 0 0115 0A17.9 17.9 0 0112 21.75a17.9 17.9 0 01-7.5-1.632z"/></svg></span>
            <div><h2 id="customer-heading">Your details</h2><p>We'll use these details for your order and payment status.</p></div>
          </div>
          <div class="form-grid">
            <div class="field full">
              <label for="customer_name">Full name <span class="required" aria-hidden="true">*</span></label>
              <input type="text" name="customer_name" id="customer_name" value="<%= user.firstname %> <%= user.lastname %>" placeholder="Your full name" autocomplete="name" required aria-required="true">
            </div>
            <div class="field">
              <label for="customer_email">Email address <span class="required" aria-hidden="true">*</span></label>
              <input type="email" name="customer_email" id="customer_email" value="<%= user.email %>" placeholder="you@example.com" autocomplete="email" inputmode="email" required aria-required="true">
            </div>
            <div class="field">
              <label for="customer_phone">Tanzanian mobile number <span class="required" aria-hidden="true">*</span></label>
              <input type="tel" name="customer_phone" id="customer_phone" value="<%= user.phone || '' %>" placeholder="0712 345 678" autocomplete="tel" inputmode="tel" aria-describedby="phone-help" required aria-required="true">
              <p class="field-help" id="phone-help"><svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/></svg><span>Use a number starting with 06 or 07, or the country code +255.</span></p>
            </div>
          </div>
        </section>

        <section class="section" aria-labelledby="payment-heading">
          <div class="section-head">
            <span class="section-icon"><svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0v.75A.75.75 0 0011.25 3h1.5a.75.75 0 00.75-.75V1.5m-3 0h3M9 18.75h6"/></svg></span>
            <div><h2 id="payment-heading">Mobile money payment</h2><p>A payment request will be initiated for the number above.</p></div>
          </div>

          <p class="networks-label">Supported Tanzanian networks</p>
          <div class="network-list" aria-label="Supported networks">
            <span class="network">M-Pesa</span><span class="network">Airtel Money</span><span class="network">Mixx by Yas</span><span class="network">Halotel</span>
          </div>

          <div class="amount-due">
            <div><span>Amount due</span><strong>TZS <%= total.toLocaleString() %></strong></div>
            <span class="currency">TZS TOTAL</span>
          </div>
          <button type="submit" class="pay-button" aria-describedby="payment-expectation">Pay with Snippe</button>
          <p class="payment-note" id="payment-expectation">
            <svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Your order starts as pending. If your network sends a prompt, approve it on your phone. Duka Store confirms the final payment status after Snippe's webhook arrives.</span>
          </p>
        </section>
      </form>
    </div>

    <aside class="summary-card" aria-labelledby="summary-heading">
      <h2 id="summary-heading">Order summary</h2>
      <div class="summary-items">
        <% items.forEach(function(item) { %>
        <div class="summary-item">
          <img src="<%= item.product.image %>" alt="">
          <div class="info"><div class="name"><%= item.product.name %></div><div class="qty">Quantity: <%= item.quantity %></div></div>
          <span class="price">TZS <%= item.subtotal.toLocaleString() %></span>
        </div>
        <% }); %>
      </div>
      <div class="summary-totals">
        <div class="row"><span>Subtotal</span><span>TZS <%= total.toLocaleString() %></span></div>
        <div class="row"><span>Shipping</span><span class="free">Free</span></div>
        <div class="grand"><span>Total</span><span class="big">TZS <%= total.toLocaleString() %></span></div>
      </div>
      <div class="trust-note">
        <svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12.75l2.25 2.25L15 9.75m-3-7.036A11.96 11.96 0 013.598 6 11.99 11.99 0 003 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75A11.96 11.96 0 0112 2.714z"/></svg>
        <div><strong>Payment powered by Snippe</strong>Your payment status is verified server-to-server. A prompt or redirect alone is not treated as proof of payment.</div>
      </div>
    </aside>
  </div>
</div>
<%- include('partials/footer') %>
